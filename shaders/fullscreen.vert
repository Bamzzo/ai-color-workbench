// ============================================================================
// 【文件总体作用】
//   离屏调色引擎的顶点着色器。它不读取任何顶点缓冲（VBO），只靠绘制调用
//   自带的顶点编号 gl_VertexID，现场生成一个盖住整个裁剪空间的大三角形。
//   三角形与视口矩形相交的部分就是全屏四边形，片元着色器因此能扫过每一个像素。
//
// 【输入与输出】
//   输入：glDrawArrays(GL_TRIANGLES, 0, 3) 提供的顶点序号 0、1、2。
//         调用前必须绑定一个空的 VAO（OpenGL 3.3 Core 不允许完全不绑 VAO）。
//   输出：gl_Position（裁剪空间坐标）与插值变量 vUv（交给 grade.frag 的纹理坐标）。
//
// 【核心技术点】
//   零 VBO 全屏三角形、裁剪空间直接赋值、透视除法前 w=1、
//   纹理坐标由顶点线性插值得到（光栅器在三角形内部做重心插值）。
// ============================================================================
#version 330 core

// 从顶点着色器传到片元着色器的纹理坐标。
// out 表示“本阶段写出、下一阶段按像素插值读入”。
// 光栅器会对三个顶点的 vUv 做重心插值，每个片元拿到自己的采样位置。
out vec2 vUv;

void main() {
    // 三个顶点的裁剪空间 xy，故意撑出一个比视口大得多的三角形：
    //   顶点 0：(-1, -1) 视口左下角
    //   顶点 1：( 3, -1) 跑到视口右侧很远的地方
    //   顶点 2：(-1,  3) 跑到视口上方很远的地方
    // 标准全屏四边形需要 4 个顶点、2 个三角形；这里用 1 个三角形盖住
    // [-1,1]×[-1,1] 的整个 NDC 正方形，视口外的部分会被硬件裁剪掉。
    // 这样做的好处：没有对角线接缝，也不需要上传顶点缓冲。
    const vec2 p[3] = vec2[3](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));

    // gl_VertexID：当前顶点在本次 glDrawArrays 里的序号，这里依次是 0、1、2。
    // vec4(xy, z, w)：z=0 表示贴在近远平面之间的中间深度（本管线已关闭深度测试，z 不影响结果）；
    // w=1 表示这已经是裁剪空间齐次坐标，透视除法 clip.xyz / w 不会再把位置缩小或放大。
    gl_Position = vec4(p[gl_VertexID], 0.0, 1.0);

    // 把裁剪空间 xy 从 [-1, 1] 线性映射到纹理坐标 [0, 1]：
    //   uv = 0.5 * (clip_xy + 1)
    // 左下 (-1,-1) → (0,0)，纹理左下；视口右上附近的边上会插值到 (1,1)。
    // 三角形伸到视口外的两个顶点，其 uv 会大于 1，但那些片元被裁掉，
    // 留在画面里的插值结果仍然落在 [0,1]，正好对应整张输入纹理。
    vUv = 0.5 * (p[gl_VertexID] + 1.0);
}
