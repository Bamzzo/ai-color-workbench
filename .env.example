# AI 服务配置：复制为 .env 后填写密钥。
# 不要把真实密钥提交到代码仓库、截图或报告。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
# 2026-07-24 起 deepseek-chat / deepseek-reasoner 已停用，统一使用 deepseek-flash
AI_MODEL=deepseek-flash
AI_API_KEY=

# 单次读写空闲超时 / 连接超时 / 整次请求总时限（秒）
AI_TIMEOUT_SECONDS=30
AI_CONNECT_TIMEOUT_SECONDS=10
AI_TOTAL_TIMEOUT_SECONDS=65
AI_POOL_TIMEOUT_SECONDS=5

# 最多 2 次额外尝试（含一次格式修复），全部受总时限约束
AI_MAX_RETRIES=2

# 采样温度：调色任务建议 0.2–0.4，过高会放大参数抖动
AI_TEMPERATURE=0.3

# 可选：true 时完全不请求云端，只使用离线模板
AI_OFFLINE_ONLY=false
